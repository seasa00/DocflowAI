POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=docflow_dev_password
APP_ENV=development

# Used when running the FastAPI service outside Docker.
DATABASE_URL=postgresql://docflow:docflow_dev_password@localhost:5432/docflow

# Files are stored privately; this directory must not be web-served.
PRIVATE_STORAGE_PATH=/app/storage
MAX_UPLOAD_BYTES=10485760
